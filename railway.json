{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "php -S 0.0.0.0:8000 -t public",
    "restartPolicyMaxRetries": 5,
    "healthchecks": {
      "enabled": true,
      "cmd": "curl -f http://localhost:8000/ || exit 1"
    }
  }
}
